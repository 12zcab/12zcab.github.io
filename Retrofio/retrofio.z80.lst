0000                             ; =====================================================================
0000                             ; Upgraded Z80 CLI with Underflow & Overflow Protection
0000                             ; Max Input: 64 Bytes (63 Characters + 1 Null Terminator)
0000                             ; =====================================================================
0000                             ; 
0000                          .ORG   0000h   
0000                             ; 
0000                MAX_BYTES:   EQU   63   ; Max characters allowed (leaves 1 byte for null)
0000   3E 0C                  LD   A,0Ch   ; Clear screen
0002   D3 01                  OUT   (01h),A   
0004   21 CB 00               LD   HL,MSG_BOOT   
0007   CD B4 00               CALL   PRINT_STR   
000A   21 8B 01     NEWPMT:   LD   HL,MSG_PROMPT   ; Print "Retrofio> "
000D   CD B4 00               CALL   PRINT_STR   
0010                             ; 
0010                MAIN_LOOP:      
0010   11 00 80               LD   DE,8000h   ; DE = Buffer pointer
0013   06 00                  LD   B,0   ; B = Character counter (starts at 0)
0015                             ; 
0015                INPUT_LOOP:      
0015   DB 01                  IN   A,(01h)   ; Poll status port
0017   FE 00                  CP   00h   
0019   CA 15 00               JP   Z,INPUT_LOOP   
001C                             ; 
001C   DB 00                  IN   A,(00h)   ; Read character from UART
001E                             ; 
001E                             ; --- Handle Backspace (Underflow Protection) ---
001E   FE 08                  CP   08h   ; Check for BS (Ctrl+H)
0020   CA 42 00               JP   Z,HANDLE_BS   
0023   FE 7F                  CP   7Fh   ; Check for DEL (modern backspace)
0025   CA 42 00               JP   Z,HANDLE_BS   
0028                             ; 
0028                             ; --- Handle Enter Key ---
0028   FE 0A                  CP   0Ah   ; Check for LF
002A   CA 59 00               JP   Z,LINE_END   
002D   FE 0D                  CP   0Dh   ; Check for CR
002F   CA 59 00               JP   Z,LINE_END   
0032                             ; 
0032                             ; --- Handle Character Input & Overflow Protection ---
0032   4F                     LD   C,A   ; Save input character in C
0033   78                     LD   A,B   ; Load current count
0034   FE 3F                  CP   MAX_BYTES   ; Is buffer full (63 chars)?
0036   D2 15 00               JP   NC,INPUT_LOOP   ; If full, ignore character and loop back
0039                             ; 
0039   79                     LD   A,C   ; Restore character
003A   D3 00                  OUT   (00h),A   ; Echo character to screen
003C   12                     LD   (DE),A   ; Store in buffer
003D   13                     INC   DE   ; Advance pointer
003E   04                     INC   B   ; Increment counter
003F   C3 15 00               JP   INPUT_LOOP   
0042                             ; 
0042                HANDLE_BS:      
0042   78                     LD   A,B   ; Check current character count
0043   FE 00                  CP   0   ; Is the buffer empty?
0045   CA 15 00               JP   Z,INPUT_LOOP   ; Yes -> Prevent underflow (ignore backspace)
0048                             ; 
0048                             ; Update internal state
0048   1B                     DEC   DE   ; Move buffer pointer back
0049   05                     DEC   B   ; Decrement character counter
004A                             ; 
004A                             ; Update terminal visual display (Erase character on screen)
004A   3E 08                  LD   A,08h   ; Move cursor back
004C   D3 00                  OUT   (00h),A   
004E   3E 20                  LD   A,20h   ; Print a space over the old character
0050   D3 00                  OUT   (00h),A   
0052   3E 08                  LD   A,08h   ; Move cursor back again
0054   D3 00                  OUT   (00h),A   
0056   C3 15 00               JP   INPUT_LOOP   
0059                             ; 
0059                LINE_END:      
0059   3E 00                  LD   A,00h   
005B   12                     LD   (DE),A   ; Null-terminate the string
005C                             ; 
005C   21 00 80               LD   HL,8000h   ; HL = Input string
005F   11 96 01               LD   DE,STR_HELP   ; DE = "help"
0062   CD BE 00               CALL   STR_CMP   
0065   CA 81 00               JP   Z,DO_HELP   
0068   11 D1 01               LD   DE,STR_INFO   ; DE = "info"
006B   CD BE 00               CALL   STR_CMP   
006E   CA 92 00               JP   Z,DO_INFO   
0071   11 4E 08               LD   DE,STR_GUI   ; DE = "gui"
0074   CD BE 00               CALL   STR_CMP   
0077   CA A3 00               JP   Z,DO_GUI   
007A   3E 0A                  LD   A,0Ah   ; No match -> Newline
007C   D3 00                  OUT   (00h),A   
007E   C3 0A 00               JP   newpmt   
0081                             ; 
0081                DO_HELP:      
0081   3E 0A                  LD   A,0Ah   
0083   D3 00                  OUT   (00h),A   
0085   21 9B 01               LD   HL,MSG_HELP   
0088   CD B4 00               CALL   PRINT_STR   
008B   3E 0A                  LD   A,0Ah   
008D   D3 00                  OUT   (00h),A   
008F   C3 0A 00               JP   newpmt   
0092                DO_INFO:      
0092   3E 0A                  LD   A,0Ah   
0094   D3 00                  OUT   (00h),A   
0096   21 D6 01               LD   HL,MSG_INFO   
0099   CD B4 00               CALL   PRINT_STR   
009C   3E 0A                  LD   A,0Ah   
009E   D3 00                  OUT   (00h),A   
00A0   C3 0A 00               JP   newpmt   
00A3                DO_GUI:      
00A3   3E 0A                  LD   A,0Ah   
00A5   D3 00                  OUT   (00h),A   
00A7   21 52 08               LD   HL,MSG_GUI   
00AA   CD B4 00               CALL   PRINT_STR   
00AD   3E 0A                  LD   A,0Ah   
00AF   D3 00                  OUT   (00h),A   
00B1   C3 0A 00               JP   newpmt   
00B4                             ; =====================================================================
00B4                             ; Subroutines & Data Section (Unchanged)
00B4                             ; =====================================================================
00B4                PRINT_STR:      
00B4   7E                     LD   A,(HL)   
00B5   FE 00                  CP   00h   
00B7   C8                     RET   Z   
00B8   D3 00                  OUT   (00h),A   
00BA   23                     INC   HL   
00BB   C3 B4 00               JP   PRINT_STR   
00BE                             ; 
00BE                STR_CMP:      
00BE   7E                     LD   A,(HL)   
00BF   47                     LD   B,A   
00C0   1A                     LD   A,(DE)   
00C1   B8                     CP   B   
00C2   C0                     RET   NZ   
00C3   FE 00                  CP   00h   
00C5   C8                     RET   Z   
00C6   23                     INC   HL   
00C7   13                     INC   DE   
00C8   C3 BE 00               JP   STR_CMP   
00CB                             ; 
